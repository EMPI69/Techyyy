# Loaded by caudal-bot.service AFTER /opt/caudal-bot/.env, so these values win.
# They describe the install layout (same as the Docker image), not your Discord server.

# tickets.db lives in data/ so the code directory can stay read-only (ReadWritePaths).
DATABASE_PATH=data/tickets.db

# Liveness endpoint for caudal-bot-healthcheck.timer. Loopback only; no ticket data.
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8081
