# Copy to .env and fill in. Never commit .env (it's in .gitignore).

# Required
BOT_TOKEN=

# Servers are set up from Discord: an administrator runs /setup in each server, which
# creates the categories and channels and saves them in the database. Nothing below is
# needed for that.
#
# Optional, for one existing server only (GUILD_ID): these IDs are used there until it
# runs /setup. They're rejected without GUILD_ID, since they'd be ambiguous.
GUILD_ID=
STAFF_ROLE_ID=
TICKETS_CATEGORY_ID=
# Comma-separated channel IDs to answer FAQs in. Empty = all public channels.
FAQ_CHANNEL_IDS=
# Channel that receives a summary + transcript of each deleted ticket.
TRANSCRIPT_LOG_CHANNEL_ID=
# Category that closed tickets move into for their 48-hour retention.
ARCHIVE_CATEGORY_ID=
# Channel for SLA warnings. Empty = post them inside the ticket.
SLA_ALERT_CHANNEL_ID=

# Optional: seconds before the same FAQ is auto-answered again in the same channel.
FAQ_COOLDOWN_SECONDS=30
# Optional: SQLite file (relative paths resolve against the project root). Docker, systemd
# and the Windows service set this to data/tickets.db themselves.
DATABASE_PATH=

# Optional: metrics dashboard. Only starts if a token is set (use 16+ random characters).
DASHBOARD_AUTH_TOKEN=
DASHBOARD_PORT=8080
DASHBOARD_HOST=127.0.0.1

# Optional: unauthenticated /health endpoint for supervisors (status flags only).
# Empty = on at 127.0.0.1:8080 (shared with the dashboard if it also uses 8080); "off" disables.
# Docker, systemd and the Windows service use 127.0.0.1:8081 themselves.
HEALTH_HOST=127.0.0.1
HEALTH_PORT=
