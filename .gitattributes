# Files executed or parsed on Linux must keep LF line endings even when committed from
# Windows (a CRLF breaks bash, systemd unit parsing and EnvironmentFile values).
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.env           text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
*.yml           text eol=lf
*.py            text eol=lf
# PowerShell scripts are run on Windows.
*.ps1           text eol=crlf
